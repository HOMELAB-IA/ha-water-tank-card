{
  "name": "ha-water-tank-card",
  "version": "0.1.0",
  "description": "Home Assistant Lovelace card for water tank / cistern level monitoring",
  "type": "module",
  "keywords": [
    "home-assistant",
    "lovelace",
    "card",
    "hacs",
    "water-tank",
    "cistern"
  ],
  "homepage": "https://github.com/HOMELAB-IA/ha-water-tank-card",
  "repository": {
    "type": "git",
    "url": "https://github.com/HOMELAB-IA/ha-water-tank-card.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "dev": "rollup -c rollup.config.mjs --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": ["eslint --fix", "prettier --write"]
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "15.3.0",
    "@rollup/plugin-typescript": "12.1.1",
    "@typescript-eslint/eslint-plugin": "8.17.0",
    "@typescript-eslint/parser": "8.17.0",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "lit": "3.2.1",
    "prettier": "3.4.2",
    "rollup": "4.68.2",
    "tslib": "2.8.1",
    "typescript": "5.7.2",
    "vitest": "5.1.0"
  }
}
